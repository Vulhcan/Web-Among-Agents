# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored and must never be committed.

############################
# Required
############################
# Get a key at https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

############################
# Model selection
############################
# Any model id your OpenRouter account can reach.
# Command-line flags (--crewmate_llm / --impostor_llm) override these.
OPENROUTER_CREWMATE_MODEL=openai/gpt-4o-mini
OPENROUTER_IMPOSTOR_MODEL=openai/gpt-4o-mini

# Per-request timeout, in seconds.
OPENROUTER_TIMEOUT_SECONDS=60

# Sampling controls. Leave blank to use each model's default.
OPENROUTER_TEMPERATURE=
OPENROUTER_TOP_P=

############################
# Prompt profile
############################
# baseline_v1  - default agent prompting
# aggressive_v1 - adds role/phase directives while preserving the output schema
PROMPT_PROFILE=baseline_v1

# Only read when PROMPT_PROFILE=aggressive_v1. Valid range: 1..5.
AGGRESSION_LEVEL=3

############################
# Run labels (optional)
############################
# Free-form strings recorded into structured-v1/runs.jsonl for every run.
# Use them to tag and later stratify your own collection.
TOURNAMENT_ID=
TOURNAMENT_CELL=
TOURNAMENT_RUN_LABEL=
TOURNAMENT_HUMAN_ROLE=
TOURNAMENT_NOTES=

############################
# Hosted deployment (optional)
############################
# Required when the backend runs on Fly.io. Clients must then send X-API-Key.
BACKEND_API_KEY=
# Comma-separated origins for CORS. Leave blank to allow all (local dev only).
ALLOWED_ORIGINS=
